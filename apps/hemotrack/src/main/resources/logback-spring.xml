<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs vão para o console (docker logs) e para o Loki (R6).
  O traceId/spanId (MDC do Micrometer Tracing) é gravado em cada linha,
  o que permite navegar log -> trace no Grafana (derived field do datasource Loki).
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="appName" source="spring.application.name"/>
  <springProperty scope="context" name="lokiUrl" source="loki.url"/>

  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${appName}] [%thread] traceId=%X{traceId:-} spanId=%X{spanId:-} %logger{40} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
    <http>
      <url>${lokiUrl}</url>
    </http>
    <format>
      <!-- Labels de baixa cardinalidade: filtráveis no LogQL, ex.: {application="app-pedidos", level="ERROR"} -->
      <label>
        <pattern>application=${appName},host=${HOSTNAME},level=%level</pattern>
        <readMarkers>true</readMarkers>
      </label>
      <message>
        <pattern>%-5level [%thread] traceId=%X{traceId:-} spanId=%X{spanId:-} %logger{40} - %msg%n%ex</pattern>
      </message>
    </format>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="LOKI"/>
  </root>
</configuration>
