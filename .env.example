# Copie para .env e troque TODAS as senhas:  cp .env.example .env
# O arquivo .env está no .gitignore e NUNCA deve ser enviado ao GitHub.

# Grafana — administrador (substitui o admin/admin padrão)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-admin

# Grafana — usuário de leitura (papel Viewer) para o professor
GRAFANA_VIEWER_USER=professor
GRAFANA_VIEWER_PASSWORD=troque-esta-senha-viewer

# (Opcional) Token de um túnel nomeado da Cloudflare, para URL fixa
# Usado com: docker compose --profile remoto-fixo up -d
CLOUDFLARE_TUNNEL_TOKEN=
